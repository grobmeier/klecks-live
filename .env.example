# Network binding requires an explicit origin and a secret host key.
HOST=127.0.0.1
PORT=5055
PUBLIC_ORIGIN=
HOST_ACCESS_KEY=
# Defaults to private when a presenter password is set; public on keyless loopback.
# EDITOR_ACCESS=private
MAX_VIEWERS=25
MAX_SESSIONS=10
FRAME_RATE=10
MAX_IMAGE_EDGE=1600
MAX_FRAME_BYTES=2097152
SESSION_LIFETIME_MS=14400000
RECONNECT_GRACE_MS=120000

# Exact IP addresses of proxies that overwrite X-Real-IP. Empty means trust none.
TRUSTED_PROXY_ADDRESSES=
